{
  "name": "Order pipeline",
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "saveDataSuccessExecution": "all"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order",
        "options": {}
      },
      "id": "00000000-0000-4000-8000-000000000001",
      "name": "New order",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "id": "00000000-0000-4000-8000-000000000002",
      "name": "Check stock",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        220,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.fail }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "00000000-0000-4000-8000-000000000003",
      "name": "Should fail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        100
      ]
    },
    {
      "parameters": {
        "errorMessage": "Card declined"
      },
      "id": "00000000-0000-4000-8000-000000000004",
      "name": "Crash",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "id": "00000000-0000-4000-8000-000000000005",
      "name": "Charge card",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "id": "00000000-0000-4000-8000-000000000006",
      "name": "Ship",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "00000000-0000-4000-8000-000000000007",
      "name": "Send receipt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1100,
        200
      ]
    }
  ],
  "connections": {
    "New order": {
      "main": [
        [
          {
            "node": "Check stock",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check stock": {
      "main": [
        [
          {
            "node": "Should fail?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should fail?": {
      "main": [
        [
          {
            "node": "Crash",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Charge card",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Charge card": {
      "main": [
        [
          {
            "node": "Ship",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ship": {
      "main": [
        [
          {
            "node": "Send receipt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
